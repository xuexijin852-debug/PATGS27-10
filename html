<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>港北合格 コマンドセンター</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+JP:wght@400;500;700;900&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #0f172a;
  --surface: #1e293b;
  --surface-2: #334155;
  --ink: #f8fafc;
  --ink-muted: #94a3b8;
  --accent: #f59e0b;
  --accent-weak: rgba(245,158,11,0.12);
  --danger: #ef4444;
  --danger-weak: rgba(239,68,68,0.12);
  --success: #22c55e;
  --success-weak: rgba(34,197,94,0.12);
  --info: #3b82f6;
  --info-weak: rgba(59,130,246,0.12);
  --line: rgba(148,163,184,0.15);
  --radius: 14px;
  --shadow: 0 1px 2px rgba(0,0,0,0.3), 0 8px 24px -12px rgba(0,0,0,0.5);
  --step-0: clamp(0.9rem, 0.85rem + 0.25vw, 1rem);
  --step-1: clamp(1.05rem, 0.95rem + 0.5vw, 1.25rem);
  --step-2: clamp(1.3rem, 1.1rem + 1vw, 1.75rem);
  --step-3: clamp(1.8rem, 1.4rem + 2vw, 2.75rem);
  --step-4: clamp(2.5rem, 1.8rem + 3.5vw, 4.5rem);
  --space: clamp(1rem, 0.8rem + 1vw, 1.5rem);
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body {
  font-family: "Inter", "Noto Sans JP", "Hiragino Sans", "Yu Gothic", sans-serif;
  background: var(--bg);
  color: var(--ink);
  font-size: var(--step-0);
  line-height: 1.7;
  min-height: 100vh;
}
.container { max-width: 900px; margin: 0 auto; padding: var(--space); }

/* Header */
header {
  text-align: center;
  padding: calc(var(--space)*2) 0;
  border-bottom: 1px solid var(--line);
  margin-bottom: calc(var(--space)*1.5);
}
header h1 {
  font-size: var(--step-3);
  font-weight: 900;
  letter-spacing: -0.03em;
  line-height: 1.2;
}
header .subtitle {
  color: var(--ink-muted);
  font-size: var(--step-0);
  margin-top: 0.5rem;
}

/* Countdown Hero */
.countdown-hero {
  background: linear-gradient(135deg, var(--surface) 0%, var(--surface-2) 100%);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: calc(var(--space)*1.5);
  text-align: center;
  margin-bottom: calc(var(--space)*1.5);
  box-shadow: var(--shadow);
}
.countdown-hero .label {
  color: var(--ink-muted);
  font-size: var(--step-0);
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin-bottom: 0.5rem;
}
.countdown-hero .days {
  font-size: var(--step-4);
  font-weight: 900;
  color: var(--accent);
  line-height: 1;
  letter-spacing: -0.04em;
}
.countdown-hero .days-label {
  color: var(--ink-muted);
  font-size: var(--step-1);
  margin-top: 0.25rem;
}
.countdown-hero .detail {
  display: flex;
  justify-content: center;
  gap: 1.5rem;
  margin-top: 1rem;
  flex-wrap: wrap;
}
.countdown-hero .detail-item {
  text-align: center;
}
.countdown-hero .detail-item .num {
  font-size: var(--step-2);
  font-weight: 800;
  color: var(--ink);
  line-height: 1;
}
.countdown-hero .detail-item .unit {
  font-size: 0.75rem;
  color: var(--ink-muted);
}

/* Cards */
.card {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: calc(var(--space)*1.2);
  margin-bottom: calc(var(--space)*1);
  box-shadow: var(--shadow);
}
.card h2 {
  font-size: var(--step-2);
  font-weight: 800;
  margin-bottom: 1rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}
.card h3 {
  font-size: var(--step-1);
  font-weight: 700;
  margin: 1rem 0 0.5rem;
}

/* Status Grid */
.status-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
  gap: 1rem;
  margin-bottom: calc(var(--space)*1.5);
}
.status-box {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 1.2rem;
  text-align: center;
  box-shadow: var(--shadow);
}
.status-box .num {
  font-size: var(--step-3);
  font-weight: 900;
  line-height: 1;
}
.status-box .label {
  font-size: 0.8rem;
  color: var(--ink-muted);
  margin-top: 0.4rem;
}
.status-box.accent { border-top: 3px solid var(--accent); }
.status-box.danger { border-top: 3px solid var(--danger); }
.status-box.success { border-top: 3px solid var(--success); }
.status-box.info { border-top: 3px solid var(--info); }
.status-box.accent .num { color: var(--accent); }
.status-box.danger .num { color: var(--danger); }
.status-box.success .num { color: var(--success); }
.status-box.info .num { color: var(--info); }

/* Progress Bar */
.progress-wrap {
  margin: 1rem 0;
}
.progress-header {
  display: flex;
  justify-content: space-between;
  font-size: 0.85rem;
  margin-bottom: 0.4rem;
}
.progress-bar {
  height: 12px;
  background: var(--surface-2);
  border-radius: 6px;
  overflow: hidden;
}
.progress-bar .fill {
  height: 100%;
  background: linear-gradient(90deg, var(--accent), #f97316);
  border-radius: 6px;
  transition: width 0.8s ease;
}

/* Today's Menu */
.menu-list {
  list-style: none;
}
.menu-list li {
  padding: 0.8rem 0;
  border-bottom: 1px solid var(--line);
  display: flex;
  align-items: flex-start;
  gap: 0.8rem;
}
.menu-list li:last-child { border-bottom: none; }
.menu-list .check {
  width: 22px;
  height: 22px;
  border: 2px solid var(--surface-2);
  border-radius: 6px;
  flex-shrink: 0;
  margin-top: 0.1rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.75rem;
  color: transparent;
  transition: all 0.2s;
}
.menu-list li.done .check {
  background: var(--success);
  border-color: var(--success);
  color: #fff;
}
.menu-list li.done .text {
  text-decoration: line-through;
  color: var(--ink-muted);
}
.menu-list .text { flex: 1; }
.menu-list .badge {
  font-size: 0.7rem;
  padding: 0.15rem 0.5rem;
  border-radius: 4px;
  font-weight: 700;
  flex-shrink: 0;
}
.badge-math { background: var(--info-weak); color: var(--info); }
.badge-eng { background: var(--success-weak); color: var(--success); }
.badge-jap { background: var(--accent-weak); color: var(--accent); }
.badge-sci { background: #a855f715; color: #a855f7; }
.badge-soc { background: #ec489915; color: #ec4899; }
.badge-diag { background: var(--danger-weak); color: var(--danger); }

/* Unit Table */
.unit-table-wrap { overflow-x: auto; }
.unit-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.85rem;
  margin-top: 0.5rem;
}
.unit-table th, .unit-table td {
  padding: 0.5rem 0.6rem;
  text-align: left;
  border-bottom: 1px solid var(--line);
  white-space: nowrap;
}
.unit-table th {
  color: var(--ink-muted);
  font-weight: 600;
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}
.unit-table tr:hover { background: rgba(255,255,255,0.03); }
.unit-table .status-select {
  background: var(--surface-2);
  color: var(--ink);
  border: 1px solid var(--line);
  border-radius: 6px;
  padding: 0.25rem 0.4rem;
  font-size: 0.8rem;
}

/* Buttons */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.6rem 1.2rem;
  border-radius: 8px;
  border: none;
  font-size: 0.9rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.2s;
  font-family: inherit;
}
.btn-primary {
  background: linear-gradient(135deg, var(--accent), #f97316);
  color: #1f1b16;
}
.btn-primary:hover { transform: translateY(-1px); filter: brightness(1.1); }
.btn-secondary {
  background: var(--surface-2);
  color: var(--ink);
  border: 1px solid var(--line);
}
.btn-secondary:hover { background: var(--line); }

/* Notification */
.notify-bar {
  display: flex;
  align-items: center;
  gap: 0.8rem;
  padding: 1rem;
  background: var(--info-weak);
  border: 1px solid var(--info);
  border-radius: var(--radius);
  margin-bottom: calc(var(--space)*1);
}
.notify-bar.enabled {
  background: var(--success-weak);
  border-color: var(--success);
}

/* Collapse */
.collapse-btn {
  width: 100%;
  text-align: left;
  background: var(--surface-2);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 1rem;
  color: var(--ink);
  font-size: var(--step-1);
  font-weight: 700;
  cursor: pointer;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 0.5rem;
}
.collapse-btn:hover { background: var(--line); }
.collapse-content {
  display: none;
  padding-bottom: 1rem;
}
.collapse-content.open { display: block; }

/* Footer */
footer {
  text-align: center;
  padding: calc(var(--space)*2) 0;
  color: var(--ink-muted);
  font-size: 0.8rem;
  border-top: 1px solid var(--line);
  margin-top: calc(var(--space)*2);
}

/* Print */
@media print {
  body { background: #fff; color: #000; }
  .no-print { display: none !important; }
  .card, .status-box, .countdown-hero {
    box-shadow: none;
    border: 1px solid #ccc;
  }
}
@page { size: A4; margin: 15mm; }

/* Reduced motion */
@media (prefers-reduced-motion: reduce) {
  * { animation: none !important; transition: none !important; }
}
</style>
</head>

// ===================== STATE =====================
let unitState = {};
let todayDone = {};
let notifyEnabled = false;

function loadState() {
  try {
    const s = localStorage.getItem("patgs27_state");
    if (s) {
      const data = JSON.parse(s);
      unitState = data.unitState || {};
      todayDone = data.todayDone || {};
      notifyEnabled = data.notifyEnabled || false;
    }
  } catch(e) {}
  const today = new Date().toDateString();
  if (todayDone._date !== today) {
    todayDone = { _date: today };
  }
}

function saveState() {
  localStorage.setItem("patgs27_state", JSON.stringify({
    unitState, todayDone, notifyEnabled
  }));
}

// ===================== COUNTDOWN =====================
function updateCountdown() {
  const now = new Date();
  const diff = examDate - now;
  if (diff <= 0) {
    document.getElementById("countdown-days").textContent = "0";
    document.getElementById("countdown-h").textContent = "0";
    document.getElementById("countdown-m").textContent = "0";
    document.getElementById("countdown-s").textContent = "0";
    return;
  }
  const d = Math.floor(diff / (1000*60*60*24));
  const h = Math.floor((diff / (1000*60*60)) % 24);
  const m = Math.floor((diff / (1000*60)) % 60);
  const s = Math.floor((diff / 1000) % 60);
  document.getElementById("countdown-days").textContent = d;
  document.getElementById("countdown-h").textContent = h;
  document.getElementById("countdown-m").textContent = m;
  document.getElementById("countdown-s").textContent = s;
}
setInterval(updateCountdown, 1000);
updateCountdown();

// ===================== PROGRESS =====================
function countMastered() {
  return Object.values(unitState).filter(v => v === "習得済み" || v === "昇格不要").length;
}
function updateProgress() {
  const mastered = countMastered();
  const total = 69;
  const target = 55;
  const rate = Math.round((mastered / target) * 100);
  document.getElementById("status-mastered").textContent = mastered;
  document.getElementById("status-rate").textContent = rate + "%";
  document.getElementById("progress-text").textContent = mastered + " / " + target;
  document.getElementById("progress-fill").style.width = Math.min(rate,100) + "%";
  // Update weekly plan status display
  units.forEach(u => {
    const st = unitState[u.id] || "未着手";
    const el = document.getElementById("wp-"+u.id);
    if (el) el.textContent = st;
  });
}

// ===================== TODAY'S MENU =====================
function renderMenu() {
  const container = document.getElementById("today-menu");
  container.innerHTML = "";
  const today = new Date().toDateString();
  document.getElementById("today-date").textContent = new Date().toLocaleDateString("ja-JP",
    {month:"long",day:"numeric",weekday:"short"});

  // Daily habits always first
  dailyHabits.forEach(item => {
    const li = document.createElement("li");
    const done = todayDone[item.id] ? "done" : "";
    li.className = done;
    li.innerHTML = `<div class="check" onclick="toggleItem('${item.id}')">✓</div>
      <div class="text">${item.text}</div>
      <span class="badge badge-${item.badge}">${item.badge==="jap"?"国語":""}</span>`;
    container.appendChild(li);
  });

  // Week 1 tasks
  week1Tasks.forEach(item => {
    const li = document.createElement("li");
    const done = todayDone[item.id] ? "done" : "";
    li.className = done;
    const badgeMap = {math:"数学",eng:"英語",jap:"国語",sci:"理科",soc:"社会",diag:"診断"};
    li.innerHTML = `<div class="check" onclick="toggleItem('${item.id}')">✓</div>
      <div class="text">${item.text}</div>
      <span class="badge badge-${item.badge}">${badgeMap[item.badge]||item.badge}</span>`;
    container.appendChild(li);
  });
}

function toggleItem(id) {
  todayDone[id] = !todayDone[id];
  saveState();
  renderMenu();
}

function resetToday() {
  const today = new Date().toDateString();
